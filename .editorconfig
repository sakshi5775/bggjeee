# EditorConfig: https://editorconfig.org
# Ensures consistent encoding (UTF-8) and line endings across editors and OS
# to avoid runtime UTF-8 / decoding issues in Dart and other source files.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.dart]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
